function uploadQuestionImage_(payload){const ctx=requireManager_(payload.token),file=payload.file||{};if(!file.base64||!file.name)throw apiError_('File gambar tidak valid.','BAD_REQUEST');const folderId=PropertiesService.getScriptProperties().getProperty('DRIVE_FOLDER_ID');if(!folderId)throw apiError_('DRIVE_FOLDER_ID belum dikonfigurasi.','NOT_CONFIGURED');const bytes=Utilities.base64Decode(String(file.base64));if(bytes.length>3000000)throw apiError_('Ukuran gambar maksimal 3 MB.','FILE_TOO_LARGE');const blob=Utilities.newBlob(bytes,String(file.mimeType||'image/jpeg'),String(file.name)),created=DriveApp.getFolderById(folderId).createFile(blob);if(PropertiesService.getScriptProperties().getProperty('PUBLIC_QUESTION_IMAGES')!=='false'){try{created.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW)}catch(error){throw apiError_('Gambar sudah diunggah ke Google Drive, tetapi tidak dapat dibagikan untuk ditampilkan di ujian. Periksa izin berbagi folder/Google Workspace.','DRIVE_SHARING_BLOCKED')}}audit_(ctx.user.userId,'UPLOAD_IMAGE',created.getId(),{name:created.getName(),bytes:bytes.length});return{fileId:created.getId(),imageUrl:drivePublicUrl_(created.getId()),name:created.getName()};}
